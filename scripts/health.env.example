# ai-health-check: unit and maximum age (hours) since its last successful run
# Format: unit max_age_hours
ai-example.service 26
# A systemd user unit (systemctl --user): start the line with "user "
# user ai-example-user.service 26
# A command that must exit 0 (its last output line is the problem otherwise), e.g. the restic backup:
# check bash ~/dhoon/scripts/backup_restic.sh --status
