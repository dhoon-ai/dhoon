# Calendars for the Assistant. Copy to config/calendar.env (never committed) and fill in
# what you use; leave the rest empty. Then: sudo systemctl restart ai-toolbox
#
# Your private calendar on this computer is always on: ~/agent-workspace/calendar/calendar.ics
# (a normal .ics file: you can import it into Google Calendar or your phone).

# Read-only calendar links, comma-separated, each optionally "Name|link":
#  - Google Calendar: Settings -> your calendar -> Integrate calendar ->
#    "Secret address in iCal format" (keep it secret: anyone with it can read the calendar)
#  - Outlook.com: Settings -> Calendar -> Shared calendars -> Publish a calendar -> ICS link
CALENDAR_ICS_URLS=
# e.g. CALENDAR_ICS_URLS=Work|https://calendar.google.com/calendar/ical/.../basic.ics

# A calendar you can also add events to, with an app password (CalDAV):
#  - iCloud: https://caldav.icloud.com, your Apple ID e-mail, an app-specific password
#    (appleid.apple.com -> Sign-In and Security -> App-Specific Passwords)
#  - Nextcloud: https://your.server/remote.php/dav, your user, an app password
#  - Fastmail: https://caldav.fastmail.com/dav/, your e-mail, an app password
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
# which of its calendars to use (empty = the first one)
CALDAV_CALENDAR=

# Google Calendar with read AND write: see docs/GUIDE.md "Calendar". After the one-time
# sign-in (python3 toolbox/calendars.py --google-setup) it is on. Which calendar:
GOOGLE_CALENDAR_ID=primary

# Where new events go: local, caldav or google (empty = Google if connected, else CalDAV
# if set, else your private calendar)
CALENDAR_ADD_TO=

# Time zone for events (empty = this computer's), e.g. America/Toronto
CALENDAR_TIMEZONE=
