# E-mail settings for the send_email tool. Copy to config/email.env (never committed),
# fill it in, then run: bash scripts/04_toolbox.sh   and test with: bash scripts/email_test.sh
#
# EMAIL_PROVIDER: gmail | zoho | zoho-in | zoho-eu | outlook | office365 | custom
#   gmail   : turn on 2-Step Verification, then Google Account -> Security -> App passwords
#   zoho    : Account -> Security -> App passwords (zoho-in for accounts made in India, zoho-eu Europe)
#   outlook : Microsoft is retiring password sign-in for apps (OAuth2 only), so this usually
#             fails. Send with Gmail or Zoho; you can still send TO an Outlook address.
EMAIL_PROVIDER=gmail
# The account that SENDS (can be a separate account just for the agent) and its app password
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD="abcd efgh ijkl mnop"

# The ONLY addresses the agent may send to (comma-separated), e.g. your personal inbox. This
# protects you if a web page tries to trick the agent into mailing your files to someone else.
# The test (scripts/email_test.sh) goes to the first one. Default: EMAIL_ADDRESS.
EMAIL_ALLOWED_TO=you@gmail.com

#EMAIL_FROM_NAME="Local AI"
#EMAIL_MAX_PER_DAY=20

# Only for EMAIL_PROVIDER=custom:
#EMAIL_SMTP_HOST=smtp.example.com
#EMAIL_SMTP_PORT=587
#EMAIL_SMTP_SECURITY=starttls
