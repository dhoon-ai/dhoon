# Optional: choose your own models.
#   cp config/models.env.example config/models.env   and edit.
# Leave a line commented out to let the scripts choose from your RAM.
# Browse models at https://ollama.com/library
# After changing, run:  bash scripts/02_download_models.sh && bash scripts/update.sh

# Main agent model. Defaults: 28+ GB RAM -> qwen3:30b-a3b-instruct-2507-q4_K_M, else qwen3:4b-instruct-2507-q4_K_M
# Prefer "instruct" (non-thinking) models: thinking models often fail to call tools.
#MODEL_MAIN=qwen3:30b-a3b-instruct-2507-q4_K_M

# Small fast model for quick questions and chat titles
#MODEL_FAST=qwen3:4b-instruct-2507-q4_K_M

# Embedding model for document search
#MODEL_EMBED=nomic-embed-text

# Model used by the ask_planner tool. Default: the main model above (fast, no extra download).
#MODEL_PLANNER=qwen3:30b-a3b-instruct-2507-q4_K_M

# Search engines for ask_planner's web research on hard tasks (SearXNG engine names,
# comma-separated). Empty = your SearXNG's usual engines. Re-run scripts/04_toolbox.sh after changing.
#RESEARCH_ENGINES="startpage,duckduckgo,brave"

# Ollama version, e.g. 0.12.6 (see: ollama --version). Empty = the newest release.
# update.sh downloads Ollama only when the installed version is different.
#OLLAMA_VERSION=

# Memory across chats (on or off). On: a small model notes what you tell it about yourself,
# next to each answer; this adds a little work for the computer. Each person can also switch
# it off in Settings -> Personalization. Run scripts/05_librechat.sh after changing.
#MEMORY=on

# Context window in tokens (how much the model keeps in mind). Default: 32768 with 28+ GB
# RAM, else 16384. Re-run scripts/ollama_settings.sh after changing.
#CONTEXT_LENGTH=32768

# How long models stay in memory after use: -1 = forever (default with 28+ GB RAM),
# else e.g. 30m. Re-run scripts/ollama_settings.sh after changing.
#KEEP_ALIVE=-1
