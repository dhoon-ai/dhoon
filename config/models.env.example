# Optional: choose your own models.
#   cp config/models.env.example config/models.env   and edit.
# Leave a line commented out to let the scripts choose from your RAM.
# Browse models at https://ollama.com/library
# After changing, run:  bash scripts/02_download_models.sh && bash scripts/update.sh

# Main agent model (both agents, the planner, the knowledge base, plugins). Defaults: 28+ GB RAM -> gemma4:26b,
# else qwen3:4b-instruct-2507-q4_K_M. The previous default was qwen3:30b-a3b-instruct-2507-q4_K_M.
# Prefer "instruct" (non-thinking) models: thinking models often fail to call tools.
#MODEL_MAIN=gemma4:26b

# Small fast model for quick questions and chat titles
#MODEL_FAST=qwen3:4b-instruct-2507-q4_K_M

# Embedding model for document search
#MODEL_EMBED=nomic-embed-text

# Model used by the ask_planner tool. Default: the main model above (fast, no extra download).
#MODEL_PLANNER=gemma4:26b

# Search engines for ask_planner's web research on hard tasks (SearXNG engine names,
# comma-separated). Empty = your SearXNG's usual engines. Re-run scripts/04_toolbox.sh after changing.
#RESEARCH_ENGINES="startpage,duckduckgo,brave"

# read_receipts (needs the optional receipt-reader package): your usual currency, for receipts that
# only print "$", and a different model if you like. Re-run scripts/04_toolbox.sh after changing.
#RECEIPT_CURRENCY=CAD
#RECEIPT_MODEL=qwen2.5vl:7b
# Read photos' text with Tesseract first, the picture only when that doesn't add up (much faster on a
# CPU). Needs: sudo apt install tesseract-ocr && ~/dhoon/runtime/venv/bin/pip install pytesseract
#RECEIPT_FAST=on

# Document search: a small reranker (a cross-encoder, about 80 MB, runs on the CPU) re-orders the best
# passages by reading the question and each passage together. Needs:
# ~/dhoon/runtime/venv/bin/pip install fastembed (the model downloads on first use). Re-run 04_toolbox.sh.
#DOC_RERANK=on

# Requests a model answers at once: 2 with 28+ GB RAM (a chat doesn't wait behind a background
# job), else 1. Each one needs memory for its own context window.
#NUM_PARALLEL=2

# Ollama version, e.g. 0.12.6 (see: ollama --version). Empty = the newest release.
# update.sh downloads Ollama only when the installed version is different.
#OLLAMA_VERSION=

# Memory across chats (on or off; off by default, the installer asks). On: when you say
# "Remember that...", the small model saves it for later chats; the first answer after a
# memory changes is slower. Each person can also switch it off in Settings ->
# Personalization. Run scripts/05_librechat.sh after changing.
#MEMORY=off

# Knowledge base of world news and market events since the models' training (on or off).
# Every night at 22:30 it adds the missing weeks from KNOWLEDGE_START (newest first, at most
# KNOWLEDGE_MAX_MINUTES a night), from Wikipedia's "Current events" and world market prices.
# Run scripts/04_toolbox.sh after changing. Do the whole catch-up now: bash scripts/knowledge.sh --catch-up
#KNOWLEDGE=on
#KNOWLEDGE_START=2024-10
#KNOWLEDGE_MAX_MINUTES=150

# Context window in tokens (how much the model keeps in mind). Default: 32768 with 28+ GB
# RAM, else 16384. Re-run scripts/ollama_settings.sh after changing.
#CONTEXT_LENGTH=32768

# How long models stay in memory after use: -1 = forever (default with 28+ GB RAM),
# else e.g. 30m. Re-run scripts/ollama_settings.sh after changing.
#KEEP_ALIVE=-1
