# Optional: choose your own models.
#   cp config/models.env.example config/models.env   and edit.
# Leave a line commented out to let the scripts choose from your RAM.
# Browse models at https://ollama.com/library
# After changing, run:  bash scripts/02_download_models.sh && bash scripts/update.sh

# Main agent model. Defaults: 45+ GB RAM -> qwen3:30b-a3b, 14+ GB -> qwen3:8b, else qwen3:4b
#MODEL_MAIN=qwen3:30b-a3b

# Small fast model for quick questions and chat titles
#MODEL_FAST=qwen3:4b

# Embedding model for document search
#MODEL_EMBED=nomic-embed-text
