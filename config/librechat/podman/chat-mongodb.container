[Unit]
Description=LibreChat database (MongoDB)

[Container]
ContainerName=chat-mongodb
Image=docker.io/library/mongo:8.0.20
Pod=librechat.pod
User=1000:1000
Volume=@DHOON_HOME@/runtime/LibreChat/data-node:/data/db
Exec=mongod --noauth --bind_ip 127.0.0.1

[Service]
# the first start pulls the image (LibreChat's is ~1 GB): give it time
TimeoutStartSec=15min
Restart=always

[Install]
WantedBy=default.target
