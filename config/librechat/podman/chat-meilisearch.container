[Unit]
Description=LibreChat search (Meilisearch)

[Container]
ContainerName=chat-meilisearch
Image=docker.io/getmeili/meilisearch:v1.35.1
Pod=librechat.pod
User=1000:1000
EnvironmentFile=@DHOON_HOME@/runtime/LibreChat/.env
Environment=MEILI_HOST=http://127.0.0.1:7700
Environment=MEILI_NO_ANALYTICS=true
Environment=MEILI_HTTP_ADDR=127.0.0.1:7700
Volume=@DHOON_HOME@/runtime/LibreChat/meili_data_v1.35.1:/meili_data

[Service]
Restart=always

[Install]
WantedBy=default.target
